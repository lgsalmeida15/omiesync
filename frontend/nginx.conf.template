server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compressão gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Proxy para o backend (rede interna Coolify)
    # Resolver Docker interno — resolve hostname dinamicamente para evitar crash no boot
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $backend "${BACKEND_HOST}";

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Repassa o IP real que o Traefik determinou (ele sobrescreve o que o
        # cliente manda, então é confiável). Usar $remote_addr aqui colocava o
        # IP do PRÓPRIO Traefik, colapsando todos os usuários num único balde de
        # rate limit (httprate.LimitByIP no backend) — a equipe inteira batia no
        # limite de /auth/login e /auth/select-grupo compartilhado.
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE — desabilita buffering para eventos em tempo real
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Vue Router — todas as rotas caem no index.html
    location / {
        try_files $uri $uri/ /index.html;
        # O index.html NUNCA pode ser cacheado sem revalidar: ele referencia os
        # chunks com hash, e os chunks são immutable (1 ano). Um index.html velho
        # em cache aponta pra chunks que o deploy já substituiu → o import() lazy
        # dá 404 e a navegação do vue-router aborta em silêncio (ex.: preso no
        # /select-grupo sem erro). no-cache força o Etag a ser revalidado sempre.
        add_header Cache-Control "no-cache";
    }

    # Cache longo para assets com hash no nome
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
